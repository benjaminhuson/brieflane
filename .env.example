# Copy to .env (or set in your host's environment). Nothing here is required to try the demo.

# --- Server ---
PORT=8787
BASE_URL=http://localhost:8787          # must match the OAuth redirect origin exactly
# NODE_ENV=production                   # automatic on Netlify: Secure/__Host- cookies, HSTS, no demo login
# DEMO_LOGIN=1                          # allow the demo workspace in production (testing only)
# ALLOWED_EMAILS=benhuson1@gmail.com    # private beta: only these Google accounts can sign in
# DATA_DIR=./data                       # local PGlite database lives here
# DEFAULT_RETENTION_DAYS=400

# --- Database. Blank = local PGlite (in ./data/pg). Production: Supabase *transaction pooler* URI (port 6543) ---
DATABASE_URL=

# --- Token encryption (required in production) ---
# 32 random bytes, base64. Generate with: npm run gen-key
TOKEN_ENC_KEY=

# --- Google OAuth (Gmail). Leave blank to use the labelled demo inbox ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI (optional). Without it, transparent rule-based extraction/briefings are used ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# DEMO_MODE=1                            # force the demo inbox even if Google is configured
